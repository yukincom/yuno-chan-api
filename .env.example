# ============================================================
# .env.example
# このファイルをコピーして .env を作成してください。
# cp .env.example .env
#
# ⚠️  .env は絶対に Git にコミットしないでください！
# ============================================================


# ============================================================
# 🤖 アシスタント基本設定
# ============================================================

ASSISTANT_NAME=ユノ

# ペルソナ（AIへの指示・改行は\nで記述）
ASSISTANT_PERSONA=優しいけどちょっとテキトー。家族のことは本当に大切に思っている。

# ============================================================
# 📇 AI設定
# ============================================================
# 会話・要約モデルのプロバイダー
# gemini / openai（grok・ollama・openrouter共通）
AI_PROVIDER = gemini

# 会話モデル（AI_PROVIDERで切り替え自由）
AI_CHAT_MODEL = gemini-2.5-flash
# 要約モデル（バッチ処理用・AI_PROVIDERで切り替え自由）
AI_SUMMARY_MODEL = gemini-2.5-flash
# 検索モデル（Gemini固定・変更不可）
AI_SEARCH_MODEL = gemini-2.5-flash

AI_MAX_OUTPUT_TOKENS = 1200
AI_RECENT_TURNS = 5

# 用途別temperature（会話は豊かに・検索と要約は正確に）
AI_CHAT_TEMPERATURE    = 0.8
AI_SUMMARY_TEMPERATURE = 0.3
AI_SEARCH_TEMPERATURE  = 0.3

# 検索トリガーワード（※検索時はAI_PROVIDERに関わらずGeminiを使用）
SEARCH_KEYWORDS = 調べて,しらべて,調査して,ちょうさして,サーチして,さーちして,ぐぐって,ググって

# ============================================================
# 🔑 APIキー
# ============================================================
# Google Gemini API キー（検索機能のため常に必須）
# https://aistudio.google.com/app/apikey で取得
GEMINI_API_KEY = your_gemini_api_key_here

# OpenAI互換プロバイダー用（AI_PROVIDER=openai の時だけ必要）
# Grok:       xai-xxxx
# OpenRouter: sk-or-xxxx
# Ollama:     なんでもOK（例: ollama）
OPENAI_API_KEY  = your_openai_compatible_key_here
# Grok:       https://api.x.ai/v1
# Ollama:     http://localhost:11434/v1
# OpenRouter: https://openrouter.ai/api/v1
OPENAI_BASE_URL = https://api.openai.com/v1# ============================================================

# Google Gemini API キー
# Grounding with Google Searchのため、Gemini APIキー必須
# https://aistudio.google.com/app/apikey で取得
GEMINI_API_KEY=your_gemini_api_key_here


# ============================================================
# 🎤 音声認識 / Whisper.cpp
# ============================================================

# whisper-cli のパス（whisper.cpp をビルドした場所）
WHISPER_CLI=/Users/yourname/AI_assistant/whisper.cpp/build/bin/whisper-cli

# 日本語モデル（kotoba-whisper 推奨）
WHISPER_MODEL=/Users/yourname/AI_assistant/whisper.cpp/models/ggml-kotoba-whisper-v2.0-q5_0.bin

# 英語モデル（英語モード時に使用）
WHISPER_MODEL_EN=/Users/yourname/AI_assistant/whisper.cpp/models/ggml-medium.en.bin

# 無音判定しきい値（0.0〜1.0、高いほど厳しい）
WHISPER_NO_SPEECH_THOLD=0.6

# 音声として受け付ける最小バイト数
SPEECH_MIN_BYTES=10000

# 短文でも認識を通すワード（カンマ区切り）
SPEECH_ALLOW_SHORT=はーい,うん,いや,やだ,だめ,ねえ,ユノ


# ============================================================
# 🔊 音声合成 / VOICEVOX, Kokoro
# ============================================================

# VOICEVOX エンジン URL（ローカル起動）
VOICEVOX_URL=http://localhost:50021

# 話者ID（2=四国めたんノーマル / 3=ずんだもんノーマル など）
VOICEVOX_SPEAKER_ID=2

# voice_server.py の URL（app.py からアクセスする）
VOICE_SERVER_URL=http://localhost:5001

# 音声ファイル保存先
VOICE_STORAGE_DIR=/tmp/voice_gen_store

# Kokoro 音声（英語TTS）
KOKORO_VOICE_YUNO=af_sarah


# ============================================================
# 🌤️ 天気設定 / Open-Meteo（APIキー不要）
# ============================================================

# お住まいの緯度・経度を設定してください
# 例: 東京付近の場合
WEATHER_LATITUDE=35.0
WEATHER_LONGITUDE=135.0

WEATHER_MORNING_HOUR=6
WEATHER_MORNING_MINUTE=30
WEATHER_NOON_HOUR=12
WEATHER_NOON_MINUTE=0


# ============================================================
# 🔖 記憶設定 / Basic Memory
# ============================================================

MEMORY_DIR=/Users/yourname/basic-memory
ARCHIVE_DIR=/Volumes/ExternalSSD/yuno-archive
SUMMARY_KEEP_DAYS=14


# ============================================================
# ⛏️ Mindcraft / アンディ
# ============================================================

MINDSERVER_URL=http://localhost:8080
MINDCRAFT_PLAYER_NAME=your_minecraft_name
ANDY_LOG_PATH=/Users/yourname/AI_assistant/mindcraft/andy.log
KOKORO_VOICE_ANDY=am_adam
ANDY_WAIT_TIMEOUT=30
ANDY_OFFLINE_MESSAGE=アンディは今、休憩中みたいだよ！またあとで話しかけてみよう！

# アンディ起動キーワード（カンマ区切り）
ANDY_KEYWORDS=アンディ,andy,Andy


# ============================================================
# 📱 通信設定 / LINE・Render・Discord（使わない場合は空欄でOK）
# ============================================================

# LINE Messaging API（Renderサーバー経由）
RENDER_URL=https://your-app.onrender.com/line-webhook

# Discord Bot
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# 通知サービスの選択（line / discord / both）
NOTIFICATION_SERVICE=line


# ============================================================
# ⚙️ サーバー設定
# ============================================================

SERVER_PORT=5000
VOICE_REQUEST_TIMEOUT=30

# アナウンスファイルのパス（デフォルトはapp.pyと同じディレクトリ）
ANNOUNCEMENTS_FILE=announcements.json
